[Unit]
Description=Microduck voice PTT client
After=robotd.service
Wants=robotd.service

[Service]
Type=forking
User=root
ExecStart=/usr/bin/tmux new-session -d -s voice /home/radxa/run_voice.sh
ExecStop=/usr/bin/tmux kill-session -t voice
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
